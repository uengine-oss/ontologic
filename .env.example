# =============================================================================
# Ontologic 플랫폼 - 루트 통합 .env
# =============================================================================
# 각 서비스의 env example 파일들의 합집합(union)입니다.
# 모든 서비스는 이 루트 .env 하나를 읽어들이도록 구성되어 있습니다.
#
# 출처:
#   data-fabric/env.example
#   agent-scheduler/env.example
#   infra/.env.example
#   robo-data-analyzer/.env.example
#   data-secure-guard/env.example
#   neo4j-text2sql/env.test.example
#   process-gpt-bpmn-extractor/agent.env.example, api.env copy.example
#   what-if-simulator/api/env_example.txt
# =============================================================================

# ── API Keys (공통) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ── Neo4j (공통 — infra docker-compose 기준 neo4j/12345strategy) ─────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345strategy
NEO4J_DATABASE=neo4j

# ── MindsDB ──────────────────────────────────────────────────────────────────
# data-fabric / what-if-simulator: HTTP API
MINDSDB_URL=http://127.0.0.1:47334
# data-secure-guard: MySQL wire protocol
MINDSDB_HOST=localhost
MINDSDB_PORT=47335
MINDSDB_USER=mindsdb
MINDSDB_PASSWORD=

# ── Target Database (모니터링 대상 DB) ──────────────────────────────────────
# [주의] agent-scheduler(postgres/rwis)와 neo4j-text2sql(mysql/mindsdb)이
#        같은 키를 다른 값으로 사용. 기본값은 agent-scheduler 기준.
TARGET_DB_TYPE=postgres
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=rwis
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=postgres
TARGET_DB_SCHEMA=
# neo4j-text2sql 테스트용 대안:
# TARGET_DB_TYPE=mysql
# TARGET_DB_HOST=localhost
# TARGET_DB_PORT=47335
# TARGET_DB_NAME=mindsdb
# TARGET_DB_USER=mindsdb
# TARGET_DB_PASSWORD=

# ── Text2SQL 서비스 ──────────────────────────────────────────────────────────
TEXT2SQL_BASE_URL=http://localhost:8000/text2sql

# ── domain-layer (인과 발견 통계 계산) ───────────────────────────────────────
# ontology-studio 의 전략 2(인과 발견)가 통계 계산을 위임하는 주소.
# origin 형(http://127.0.0.1:8001)과 접두사 포함형(.../whatif) 을 모두 받는다.
# api-gateway(9000) 를 경유하지 말 것 — 30초 응답 타임아웃이 분석을 끊는다.
DOMAIN_LAYER_URL=http://127.0.0.1:8001
DOMAIN_LAYER_TIMEOUT_SECONDS=120

# ── LLM 설정 (neo4j-text2sql) ────────────────────────────────────────────────
LLM_PROVIDER=google
LLM_MODEL=gemini-3-flash-preview
IS_USE_LLM_CACHE=false

# ── Supabase / ProcessGPT (agent-scheduler, process-gpt-bpmn-extractor) ─────
SUPABASE_URL=https://gjdyydowgrinjjkfkwtl.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SERVICE_ROLE_KEY=your-service-role-key-here
USER_JWT=your-user-jwt-here
TENANT_ID=uengine
USER_EMAIL=jyjang@uengine.org

# ── process-gpt-bpmn-extractor (에이전트 서버) ──────────────────────────────
AGENT_ORCH=pdf2bpmn
POLLING_INTERVAL=5
TASK_TIMEOUT=3600

# ── data-secure-guard ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8006
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3306
DEFAULT_ROW_LIMIT=100
MAX_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_DIR=./logs
MAX_QUERIES_PER_MINUTE=100
MAX_CONNECTIONS_PER_IP=10

# ── 로깅 (공통) ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── PostgreSQL (infra docker-compose 기본값) ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=meetingroom

# ── robo-data-analyzer (ROBO_* 네임스페이스) ────────────────────────────────
# LLM config: llm_configs/<name>.yaml 의 <name>
ROBO_LLM_CONFIG=
ROBO_LLM_API_KEY=
ROBO_CACHE_ENABLED=false
ROBO_AGENT_SCAN_MAX_CALLS=30
ROBO_AGENT_RESIDUAL_MAX_CALLS=15
ROBO_AGENT_CONTEXT_EDITING_TRIGGER_TOKENS=80000
ROBO_AGENT_SCAN_REGEX_MIN_OP_RATIO=0.5
ROBO_BUDGET_RUN_USD=20.0
ROBO_NEO4J_URI=bolt://localhost:7687
ROBO_NEO4J_USER=neo4j
ROBO_NEO4J_PASSWORD=12345strategy
ROBO_NEO4J_DATABASE=neo4j
ROBO_NEO4J_UNWIND_BATCH_SIZE=2000
ROBO_NEO4J_RETRY_MAX_ATTEMPTS=5
ROBO_NEO4J_RETRY_BACKOFF_SECONDS=2.0
ROBO_PIPELINE_MAX_CONCURRENCY=8
ROBO_PIPELINE_FILE_CONCURRENCY=4
ROBO_PIPELINE_BIG_CONTEXT_THRESHOLD_TOKENS=1000
ROBO_PIPELINE_RESIDUAL_SAMPLE_SIZE=30
ROBO_PIPELINE_RESIDUAL_MAX_ROUNDS=3
ROBO_PIPELINE_EMBED_ENABLED=true
ROBO_CATALOG_ENABLED=true
ROBO_LOG_DIR=./logs
ROBO_LOG_MASK_SECRETS=true
ROBO_LOG_FILE_ENABLED=true
ROBO_LOG_LEVEL=INFO
ROBO_DATA_DIR=./data

# ── what-if-simulator (WHATIF_* 네임스페이스) ───────────────────────────────
WHATIF_API_HOST=0.0.0.0
WHATIF_API_PORT=8001
WHATIF_MYSQL_HOST=localhost
WHATIF_MYSQL_PORT=3307
WHATIF_MYSQL_DATABASE=sample_db
WHATIF_MYSQL_USER=sampleuser
WHATIF_MYSQL_PASSWORD=samplepass123
WHATIF_NEO4J_URI=bolt://localhost:7687
WHATIF_NEO4J_USER=neo4j
WHATIF_NEO4J_PASSWORD=12345strategy
WHATIF_NEO4J_DATABASE=neo4j
WHATIF_MINDSDB_URL=http://127.0.0.1:47334
WHATIF_TEXT2SQL_URL=http://localhost:8000
WHATIF_TEST_RATIO=0.2
WHATIF_SIGNIFICANCE_LEVEL=0.05
WHATIF_MIN_CORRELATION=0.35

# ── ontology-studio 질의응답 → 표준 MCP 경유 (spec 012) ─────────────────────────
# 스튜디오 답변 모드의 그래프·데이터소스 도구가 ontology_mcp 서버를 경유한다.
# 켜져 있으면 **MCP 서버(기본 8100)가 떠 있어야** 답한다:
#   cd ontology-studio && MCP_TRANSPORT=http MCP_PORT=8100 \
#     MCP_ALLOW_DATASOURCE_EXPANSION=true uv run python -m backend.src.modules.ontology_mcp
# 끄면 프로세스 안의 파이썬 도구로 돌아간다 — 계약이 갈라지므로 탈출구로만 쓴다.
ANSWER_TOOLS_VIA_MCP=true
ANSWER_MCP_TRANSPORT=http
# 비워 두면 MCP_PORT 에서 유도한다(127.0.0.1). 어떤 형태로 주든 `.../mcp` 로 정규화된다.
# ANSWER_MCP_URL=http://127.0.0.1:8100/mcp
ANSWER_MCP_TIMEOUT=60
# board 도 같은 서버를 본다 (spec 011). 두 소비자가 같은 클라이언트 구현을 쓴다.
# BOARD_MCP_URL=http://127.0.0.1:8100/mcp
# 나머지 ontology-studio 키는 ontology-studio/.env.example 참고.
