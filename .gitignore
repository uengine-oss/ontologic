# ============================================
# Robo Analytics Platform - Root .gitignore
# ============================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.env
*.egg-info/
dist/
build/
*.egg

# === Node.js ===
node_modules/
npm-debug.log*
yarn-error.log*

# === Java / Maven ===
target/
*.class
*.jar
!antlr-code-parser/antlr-*.jar

# === IDEs ===
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# === Logs ===
*.log
log/

# === Data & Generated (large files) ===
data/analysis/
data/source/
data/ddl/
generated_data/
uploads/
*.tar.gz

# === Large folders (samples, docs, installers) ===
sample/
# docs/ 는 127MB 매뉴얼·PDF 때문에 무시한다. 다만 계약 문서는 여러 서비스가 참조하므로
# 반드시 추적돼야 한다 — 디렉터리 자체를 무시하면 git 이 내려가지 않아 negation 이 먹지
# 않으므로 `docs/*` 로 쓴다.
docs/*
!docs/catalog-schema.md
!docs/graph-schema-contract.md
!docs/agentic-rag-walkthrough.md
# 사업·설계 결정 문서는 스펙이 링크하므로 추적한다. 증거(영상·캡처, 11MB)는 계속 무시한다.
!docs/business/
docs/business/*
!docs/business/*.md
backup/
rwis-installer/
langchain-text2sql/

# === Large files (>100MB, GitHub limit) ===
# SQL dump/insert files
sample/water-plant/output/rditag_sql/
rwis-installer/sql/rditag/
rwis-installer/sql/dml/RDR01MI_*.sql
rwis-installer/sql/dml/RDF01HH_TB_INSERT.sql
rwis-installer/sql/dml/RDR15MI_TB_INSERT.sql

# Large docs & dumps
docs/충주정수장*
backup/sample/water-plant/neo4j*dump/
backup/sample/water-plant/output.zip
sample/water-plant/neo4j*dump/

# === Build artifacts ===
dist/
*.pyc

# === Cache ===
.cache/
.llm_cache.db
.pytest_cache/

# === Environment ===
.env
.env.*
!.env.example
!env.example

# === OS ===
.DS_Store
Thumbs.db

# === Submodules (managed separately) ===
# These are registered as git submodules - do NOT add them here
# antlr-code-parser/
# api-gateway/
# data-fabric/
# data-secure-guard/
# domain-layer/
# infra/
# langchain-text2sql/
# neo4j-text2sql/
# process-gpt-bpmn-extractor/
# robo-data-analyzer/
# robo-data-catalog/
# robo-data-glossary/
# robo-data-frontend/

# Private Datas
p_*
.cursor
# 데이터 디렉터리 백업과 데모 영상·음성 생성물 (스크립트로 재생성)
data.bak.*/
demo/**/*.mp4
demo/**/*.webm
demo/**/*.wav
